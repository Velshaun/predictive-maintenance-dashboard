# ─────────────────────────────────────────────────────────────────────────────
# MaintainIQ Platform — Backend environment variables
# Copy this file to .env and fill in the values for local development.
# For Railway: add these in your service → Variables tab (never commit .env).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Railway automatically injects DATABASE_URL when you add a PostgreSQL plugin
# to your project.  For local development use Docker Compose (see README).
DATABASE_URL=postgresql://user:password@localhost:5432/maintainiq

# ── AI / Claude ──────────────────────────────────────────────────────────────
# Anthropic Claude API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Deployment ───────────────────────────────────────────────────────────────
# Set to "production" on Railway; defaults to "development" locally
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * for local dev or replace with your Vercel deployment URL in production:
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=*
