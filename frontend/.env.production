# Production environment — baked into the React bundle at build time.
# Set REACT_APP_API_URL to your AWS Application Load Balancer DNS name or API Gateway URL.
# When deploying to Vercel (static CDN), all /api/* requests will be proxied
# to this origin. Leave blank ONLY if the frontend is served from the same
# origin as the backend (e.g., the nginx sidecar in Docker/EKS).
REACT_APP_API_URL=https://api.maintainiq.com
