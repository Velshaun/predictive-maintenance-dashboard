# Production environment — baked into the React bundle at build time.
# Points directly to the backend-service LoadBalancer on EKS (port 8000).
# When deployed on Vercel (static CDN), React hits this URL directly —
# there is no nginx proxy layer like in the EKS frontend pod, so we must
# use the backend LB hostname, not the frontend nginx LB hostname.
REACT_APP_API_URL=http://a26140169fa9248c4b5caa1248d8d2ee-1698140667.us-east-2.elb.amazonaws.com:8000
