# Production environment — baked into the React bundle at build time.
#
# REACT_APP_API_URL is intentionally empty so axios uses relative URLs
# (e.g. /api/machines/).  Vercel's edge proxy (vercel.json rewrites)
# intercepts every /api/* request server-side and forwards it to the
# AWS backend LoadBalancer — eliminating both mixed-content errors
# (HTTPS page → HTTP backend) and CORS issues entirely.
#
# If you move away from Vercel, set this to the backend LB URL:
#   REACT_APP_API_URL=http://a26140169fa9248c4b5caa1248d8d2ee-1698140667.us-east-2.elb.amazonaws.com:8000
REACT_APP_API_URL=
