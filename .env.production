# Production environment — baked into the React bundle at build time.
# This points to the AWS EKS LoadBalancer that serves the nginx frontend.
# nginx proxies all /api/* requests internally to backend-service:8000.
# When deploying to Vercel (static CDN), this same URL is used so the React
# app can reach the backend through the load balancer.
REACT_APP_API_URL=http://aa98d1adfbfea4c8ca56c8d6dddb606c-1269872415.us-east-2.elb.amazonaws.com
