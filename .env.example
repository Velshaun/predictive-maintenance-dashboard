# Copy this file to .env.local (development) or .env.production (production build).
# All REACT_APP_* variables are inlined into the JS bundle — never store secrets here.

# Backend API base URL.
# Development: leave blank to use the CRA proxy (package.json → "proxy": "http://localhost:8000")
# Production (Vercel):  set to your AWS ALB DNS or API Gateway URL
#   e.g. https://api.maintainiq.com  or  https://<lb-name>.us-east-2.elb.amazonaws.com
REACT_APP_API_URL=
